---
import Layout from '../../layouts/Layout.astro';
import { getMaterias, getDepartamentos } from '../../lib/db';

const searchParams = Astro.url.searchParams;
const filtroDepto = searchParams.get('depto') || 'ALL';

const departamentos = await getDepartamentos();
const materias = await getMaterias(filtroDepto === 'ALL' ? undefined : filtroDepto);

// Group materias by department
const materiasPorDepto: Record<string, any[]> = {};
for (const m of materias) {
  const deptoNom = m.departamento || 'Sin Departamento';
  if (!materiasPorDepto[deptoNom]) {
    materiasPorDepto[deptoNom] = [];
  }
  materiasPorDepto[deptoNom].push(m);
}
---

<Layout 
  title="Catálogo de Materias" 
  description="Catálogo de asignaturas con sus agrupamientos, planificaciones y bibliografía de estudio"
>
  <div class="container py-8">
    <!-- Header -->
    <div class="page-header">
      <div>
        <div class="breadcrumbs">
          <a href="/">Inicio</a>
          <span>/</span>
          <span class="current">Materias</span>
        </div>
        <h1 class="page-title">Catálogo de Asignaturas</h1>
        <p class="page-subtitle">
          Seleccioná cualquier materia para consultar su historial de planificaciones cuatrimestrales y el detalle de toda su bibliografía registrada.
        </p>
      </div>

      <!-- Department Filter Pills -->
      <div class="depto-pills">
        <a 
          href="/materias" 
          class={`pill-btn ${filtroDepto === 'ALL' ? 'active' : ''}`}
        >
          Todos ({materias.length})
        </a>
        {departamentos.map((d: any) => (
          <a 
            href={`/materias?depto=${d.codigo}`} 
            class={`pill-btn ${filtroDepto === d.codigo ? 'active' : ''}`}
          >
            {d.nombre} ({d.cant_asignaturas})
          </a>
        ))}
      </div>
    </div>

    <!-- Groups by Department -->
    <div class="deptos-list">
      {Object.entries(materiasPorDepto).map(([deptoNom, list]) => (
        <section class="depto-section">
          <div class="depto-section-header">
            <h2 class="depto-title">
              <span class="depto-bullet"></span>
              {deptoNom}
            </h2>
            <span class="badge badge-periodo">{list.length} asignatura{list.length === 1 ? '' : 's'}</span>
          </div>

          <div class="materias-grid">
            {list.map((m: any) => (
              <a 
                href={`/materias/${m.codigo}`} 
                class="materia-card glass-card"
                id={`materia-card-${m.codigo}`}
              >
                <div class="materia-card-top">
                  <span class="materia-code mono">{m.codigo}</span>
                  <div class="materia-badge-group">
                    <span class="badge badge-tipo-libro">
                      {m.total_materiales} recurso{m.total_materiales === 1 ? '' : 's'}
                    </span>
                  </div>
                </div>

                <h3 class="materia-name">{m.nombre}</h3>

                <div class="materia-meta">
                  <div class="materia-meta-row">
                    <span class="m-label">Agrupamiento:</span>
                    <span class="m-val mono">{m.agrupamientos}</span>
                  </div>
                  <div class="materia-meta-row">
                    <span class="m-label">Actividad:</span>
                    <span class="m-val">{m.total_cuatrimestres} cuatrimestre{m.total_cuatrimestres === 1 ? '' : 's'}</span>
                  </div>
                </div>

                <div class="materia-card-footer">
                  <span class="view-link">
                    Ver planificaciones y bibliografía
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .py-8 {
    padding-top: 36px;
    padding-bottom: 48px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .breadcrumbs a:hover {
    color: var(--primary);
  }

  .breadcrumbs .current {
    color: var(--text-muted);
  }

  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 36px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 24px;
  }

  .page-title {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .page-subtitle {
    font-size: 15px;
    color: var(--text-muted);
    max-width: 640px;
  }

  .depto-pills {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill-btn {
    padding: 8px 16px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .pill-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .pill-btn.active {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.3) 0%, rgba(99, 102, 241, 0.15) 100%);
    border-color: #6366f1;
    color: #ffffff;
    box-shadow: 0 2px 10px rgba(99, 102, 241, 0.25);
  }

  .deptos-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .depto-section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .depto-title {
    font-size: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .depto-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary);
  }

  .materias-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 20px;
  }

  .materia-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
  }

  .materia-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .materia-code {
    font-size: 13px;
    font-weight: 700;
    color: #818cf8;
    background: rgba(99, 102, 241, 0.12);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(99, 102, 241, 0.25);
  }

  .materia-name {
    font-size: 17px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 16px;
    line-height: 1.35;
  }

  .materia-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    margin-bottom: 18px;
    padding-top: 12px;
    border-top: 1px dashed var(--border-subtle);
  }

  .materia-meta-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  .m-label {
    color: var(--text-dim);
    font-size: 12px;
  }

  .m-val {
    color: var(--text-main);
    font-weight: 500;
  }

  .materia-card-footer {
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--primary);
    transition: transform 0.2s ease;
  }

  .materia-card:hover .view-link {
    color: #818cf8;
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .materias-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
