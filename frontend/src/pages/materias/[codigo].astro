---
import Layout from '../../layouts/Layout.astro';
import MaterialCard from '../../components/MaterialCard.astro';
import { getMateriaDetail } from '../../lib/db';

const { codigo } = Astro.params;

if (!codigo) {
  return Astro.redirect('/materias');
}

const data = await getMateriaDetail(codigo);

if (!data) {
  return Astro.redirect('/materias');
}

const { nombre, departamento, agrupamientos, planificaciones, materiales } = data;
---

<Layout 
  title={`${codigo} - ${nombre}`} 
  description={`Planificaciones y bibliografía de ${codigo} - ${nombre} (${departamento})`}
>
  <div class="container py-8">
    <!-- Breadcrumbs -->
    <div class="breadcrumbs">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/materias">Materias</a>
      <span>/</span>
      <span class="current mono">{codigo}</span>
    </div>

    <!-- Subject Header Card -->
    <div class="subject-hero glass-card">
      <div class="subject-hero-top">
        <div class="subject-badge-group">
          <span class="badge badge-depto">{departamento}</span>
          <span class="badge badge-periodo mono">Código {codigo}</span>
        </div>

        <a href="/materias" class="btn btn-outline back-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Volver al catálogo
        </a>
      </div>

      <h1 class="subject-title">{nombre}</h1>

      <div class="subject-summary-stats">
        <div class="summary-stat">
          <span class="num">{materiales.length}</span>
          <span class="label">Recursos de Estudio</span>
        </div>
        <div class="summary-stat">
          <span class="num">{planificaciones.length}</span>
          <span class="label">Cuatrimestres Registrados</span>
        </div>
        <div class="summary-stat">
          <span class="num">{agrupamientos.length}</span>
          <span class="label">Agrupamiento{agrupamientos.length === 1 ? '' : 's'} Cátedra</span>
        </div>
      </div>

      {agrupamientos.length > 0 && (
        <div class="agrupamientos-box">
          <span class="box-title">Agrupamientos y Comisiones Asociadas:</span>
          <div class="agrup-list">
            {agrupamientos.map((ag: any) => (
              <div class="agrup-pill">
                <strong class="mono">{ag.codigo_agrupamiento}</strong>: {ag.denominacion}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- SECTION 1: PLANIFICACIONES POR CUATRIMESTRE -->
    <section class="section-block">
      <div class="section-title-row">
        <h2>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Historial de Planificaciones por Cuatrimestre
        </h2>
        <span class="badge badge-periodo">{planificaciones.length} períodos registrados</span>
      </div>

      {planificaciones.length === 0 ? (
        <p class="empty-msg">No se registran planificaciones cuatrimestrales para esta asignatura.</p>
      ) : (
        <div class="table-container glass-card">
          <table class="data-table">
            <thead>
              <tr>
                <th>Período</th>
                <th>Docente Responsable</th>
                <th>Agrupamiento</th>
                <th>Estado Carga</th>
                <th>Materiales Cargados</th>
                <th>Constancia Drive</th>
              </tr>
            </thead>
            <tbody>
              {planificaciones.map((pl: any) => (
                <tr>
                  <td>
                    <span class="badge badge-periodo">{pl.periodo}</span>
                  </td>
                  <td>
                    <div class="docente-cell">
                      <strong>{pl.docente_responsable || 'No especificado'}</strong>
                      {pl.docente_email && (
                        <span class="docente-email mono">{pl.docente_email}</span>
                      )}
                    </div>
                  </td>
                  <td>
                    <span class="mono text-muted">{pl.codigo_agrupamiento}</span>
                  </td>
                  <td>
                    {pl.completa ? (
                      <span class="badge badge-status-completa">✓ Completa</span>
                    ) : (
                      <span class="badge badge-status-incompleta">Pendiente / Sin carga</span>
                    )}
                  </td>
                  <td>
                    <span class="mono font-bold">
                      {pl.total_materiales} items
                      {pl.cantidad_declarada > 0 && pl.cantidad_declarada !== parseInt(pl.total_materiales) && (
                        <span class="text-dim"> (decl: {pl.cantidad_declarada})</span>
                      )}
                    </span>
                  </td>
                  <td>
                    {pl.drive_file_link ? (
                      <a 
                        href={pl.drive_file_link} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="btn-drive-table"
                        title="Abrir formulario/archivo en Drive"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                          <polyline points="15 3 21 3 21 9"></polyline>
                          <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                        Ver en Drive
                      </a>
                    ) : (
                      <span class="text-dim">-</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <!-- SECTION 2: BIBLIOGRAFÍA Y MATERIALES DE ESTUDIO -->
    <section class="section-block">
      <div class="section-title-row">
        <h2>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          Bibliografía y Recursos de Estudio
        </h2>
        <span class="badge badge-tipo-libro">{materiales.length} recursos disponibles</span>
      </div>

      {materiales.length === 0 ? (
        <div class="empty-materials glass-card">
          <p>Esta materia aún no tiene materiales de estudio detallados cargados en la base de datos.</p>
        </div>
      ) : (
        <div class="materials-grid">
          {materiales.map((m: any) => (
            <MaterialCard 
              material={{
                ...m,
                materia_codigo: codigo,
                materia_nombre: nombre,
                departamento: departamento
              }} 
            />
          ))}
        </div>
      )}
    </section>
  </div>
</Layout>

<style>
  .py-8 {
    padding-top: 36px;
    padding-bottom: 50px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 20px;
  }

  .breadcrumbs a:hover {
    color: var(--primary);
  }

  .breadcrumbs .current {
    color: #e2e8f0;
    font-weight: 600;
  }

  /* SUBJECT HERO */
  .subject-hero {
    padding: 32px;
    margin-bottom: 40px;
    border-color: rgba(99, 102, 241, 0.25);
  }

  .subject-hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .subject-badge-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .back-btn {
    padding: 6px 14px;
    font-size: 13px;
  }

  .subject-title {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 800;
    margin-bottom: 24px;
    color: #ffffff;
  }

  .subject-summary-stats {
    display: flex;
    gap: 28px;
    padding: 16px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .summary-stat {
    display: flex;
    flex-direction: column;
  }

  .summary-stat .num {
    font-size: 28px;
    font-weight: 800;
    color: #818cf8;
    line-height: 1.1;
  }

  .summary-stat .label {
    font-size: 12px;
    color: var(--text-dim);
    font-weight: 500;
  }

  .agrupamientos-box {
    background: rgba(255, 255, 255, 0.025);
    border-radius: var(--radius-md);
    padding: 14px 18px;
  }

  .box-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 8px;
  }

  .agrup-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .agrup-pill {
    font-size: 13px;
    color: var(--text-muted);
  }

  .agrup-pill strong {
    color: #c7d2fe;
  }

  /* SECTION BLOCKS */
  .section-block {
    margin-bottom: 48px;
  }

  .section-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .section-title-row h2 {
    font-size: 22px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* DATA TABLE */
  .table-container {
    overflow-x: auto;
    padding: 6px;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }

  .data-table th {
    padding: 14px 16px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    border-bottom: 1px solid var(--border-subtle);
  }

  .data-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-main);
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table tbody tr:hover td {
    background: rgba(255, 255, 255, 0.03);
  }

  .docente-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .docente-email {
    font-size: 11px;
    color: var(--text-dim);
  }

  .btn-drive-table {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #67e8f9;
    background: rgba(6, 182, 212, 0.12);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(6, 182, 212, 0.25);
  }

  .btn-drive-table:hover {
    background: rgba(6, 182, 212, 0.25);
    color: #ffffff;
  }

  /* MATERIALS GRID */
  .materials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 20px;
  }

  .empty-materials {
    text-align: center;
    padding: 40px;
    color: var(--text-muted);
  }
</style>
