---
import Layout from '../layouts/Layout.astro';
import MaterialCard from '../components/MaterialCard.astro';
import { getStats, getDepartamentos, getPeriodos, getTiposMaterial, searchMateriales } from '../lib/db';

const stats = await getStats();
const departamentos = await getDepartamentos();
const periodos = await getPeriodos();
const tipos = await getTiposMaterial();

// Query params for initial SSR filtering
const searchParams = Astro.url.searchParams;
const q = searchParams.get('q') || '';
const depto = searchParams.get('depto') || 'ALL';
const periodo = searchParams.get('periodo') || 'ALL';
const tipo = searchParams.get('tipo') || 'ALL';

const materiales = await searchMateriales({
  q,
  depto,
  periodo,
  tipo,
  limit: 100
});
---

<Layout title="Buscador de Bibliografía y Planificaciones">
  <!-- HERO SECTION -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="sparkle">✦</span>
        <span>Base de Datos Académica FIUBA</span>
      </div>

      <h1 class="hero-title">
        Consulta de <span class="gradient-text">Planificaciones</span> y <span class="gradient-text-alt">Bibliografía</span>
      </h1>

      <p class="hero-subtitle">
        Explorá el material pedagógico, libros, guías de trabajos prácticos, apuntes de cátedra y aulas virtuales declarados por los docentes a lo largo de los cuatrimestres.
      </p>

      <!-- KPI STATS -->
      <div class="stats-grid">
        <div class="stat-card glass-card">
          <div class="stat-icon icon-cyan">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
          <div class="stat-data">
            <span class="stat-number">{stats.total_materiales}</span>
            <span class="stat-label">Recursos de Estudio</span>
          </div>
        </div>

        <div class="stat-card glass-card">
          <div class="stat-icon icon-indigo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </div>
          <div class="stat-data">
            <span class="stat-number">{stats.total_materias}</span>
            <span class="stat-label">Asignaturas Catalogadas</span>
          </div>
        </div>

        <div class="stat-card glass-card">
          <div class="stat-icon icon-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="stat-data">
            <span class="stat-number">{stats.total_docentes}</span>
            <span class="stat-label">Docentes Responsables</span>
          </div>
        </div>

        <div class="stat-card glass-card">
          <div class="stat-icon icon-purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div class="stat-data">
            <span class="stat-number">{stats.total_periodos}</span>
            <span class="stat-label">Cuatrimestres Históricos</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEARCH & FILTER TOOLBAR -->
  <section class="search-section">
    <div class="container">
      <div class="search-card glass-card">
        <form method="GET" action="/" id="filter-form" class="filter-form">
          <!-- Text search -->
          <div class="search-input-wrapper">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
              type="text" 
              name="q" 
              id="search-query-input"
              value={q} 
              placeholder="Buscar por libro, autor, tema, ISBN, o código de materia (ej. Probabilidad, Epp, 6106, 8111)..." 
              class="input-text search-field"
            />
            {q && (
              <a href="/" class="clear-search-btn" title="Limpiar búsqueda">✕</a>
            )}
          </div>

          <!-- Select dropdowns -->
          <div class="filters-row">
            <div class="filter-group">
              <label for="filter-depto" class="filter-label">Departamento</label>
              <select name="depto" id="filter-depto" class="select-input">
                <option value="ALL" selected={depto === 'ALL'}>Todos los departamentos</option>
                {departamentos.map((d: any) => (
                  <option value={d.codigo} selected={depto === d.codigo}>
                    {d.nombre} ({d.cant_materiales})
                  </option>
                ))}
              </select>
            </div>

            <div class="filter-group">
              <label for="filter-periodo" class="filter-label">Cuatrimestre</label>
              <select name="periodo" id="filter-periodo" class="select-input">
                <option value="ALL" selected={periodo === 'ALL'}>Todos los cuatrimestres</option>
                {periodos.map((p: any) => (
                  <option value={p.codigo} selected={periodo === p.codigo}>
                    {p.codigo} ({p.cant_materiales} items)
                  </option>
                ))}
              </select>
            </div>

            <div class="filter-group">
              <label for="filter-tipo" class="filter-label">Tipo de Recurso</label>
              <select name="tipo" id="filter-tipo" class="select-input">
                <option value="ALL" selected={tipo === 'ALL'}>Todos los tipos</option>
                {tipos.map((t: any) => (
                  <option value={t.tipo_material} selected={tipo === t.tipo_material}>
                    {t.tipo_material} ({t.cantidad})
                  </option>
                ))}
              </select>
            </div>

            <div class="filter-actions">
              <button type="submit" class="btn btn-primary filter-submit-btn" id="filter-submit-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                Filtrar
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- RESULTS SECTION -->
  <section class="results-section">
    <div class="container">
      <div class="results-header">
        <div class="results-count">
          <h2>Recursos Encontrados</h2>
          <span class="count-badge">{materiales.length} resultado{materiales.length === 1 ? '' : 's'}</span>
        </div>

        {(q || depto !== 'ALL' || periodo !== 'ALL' || tipo !== 'ALL') && (
          <div class="active-filters">
            <span class="active-filter-label">Filtros activos:</span>
            {q && <span class="badge badge-periodo">"{q}"</span>}
            {depto !== 'ALL' && <span class="badge badge-depto">Depto: {depto}</span>}
            {periodo !== 'ALL' && <span class="badge badge-periodo">{periodo}</span>}
            {tipo !== 'ALL' && <span class="badge badge-tipo-libro">{tipo}</span>}
            <a href="/" class="clear-all-link">Limpiar todo</a>
          </div>
        )}
      </div>

      {materiales.length === 0 ? (
        <div class="empty-state glass-card">
          <div class="empty-icon">🔍</div>
          <h3>No se encontraron materiales</h3>
          <p>Probá cambiando las palabras clave o seleccionando "Todos" en los filtros de departamento o cuatrimestre.</p>
          <a href="/" class="btn btn-primary" style="margin-top: 16px;">Ver todo el catálogo</a>
        </div>
      ) : (
        <div class="materials-grid" id="materials-grid">
          {materiales.map((m: any) => (
            <MaterialCard material={m} />
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .hero-section {
    padding: 48px 0 24px 0;
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.28);
    color: #a5b4fc;
    padding: 6px 16px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .sparkle {
    color: #818cf8;
  }

  .hero-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 16px;
    max-width: 900px;
    letter-spacing: -0.03em;
  }

  .gradient-text {
    background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .gradient-text-alt {
    background: linear-gradient(135deg, #38bdf8 0%, #34d399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 720px;
    margin-bottom: 36px;
    line-height: 1.6;
  }

  /* STATS GRID */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    width: 100%;
    max-width: 1100px;
  }

  .stat-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    text-align: left;
  }

  .stat-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-cyan {
    background: rgba(6, 182, 212, 0.15);
    color: #22d3ee;
    border: 1px solid rgba(6, 182, 212, 0.3);
  }

  .icon-indigo {
    background: rgba(99, 102, 241, 0.15);
    color: #818cf8;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  .icon-emerald {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .icon-purple {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .stat-data {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: 26px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-dim);
    font-weight: 500;
  }

  /* SEARCH SECTION */
  .search-section {
    padding: 24px 0;
  }

  .search-card {
    padding: 24px;
    border-color: rgba(99, 102, 241, 0.2);
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }

  .search-icon {
    position: absolute;
    left: 18px;
    color: var(--text-dim);
    pointer-events: none;
  }

  .search-field {
    padding-left: 50px;
    padding-right: 40px;
    height: 52px;
    font-size: 15px;
    background: rgba(10, 15, 26, 0.9);
  }

  .clear-search-btn {
    position: absolute;
    right: 16px;
    color: var(--text-dim);
    font-size: 16px;
    padding: 4px;
    cursor: pointer;
  }

  .clear-search-btn:hover {
    color: #ffffff;
  }

  .filters-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr) auto;
    gap: 16px;
    align-items: flex-end;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .filter-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .filter-submit-btn {
    height: 45px;
    padding: 0 24px;
  }

  /* RESULTS */
  .results-section {
    padding: 16px 0 40px 0;
  }

  .results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .results-count {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .results-count h2 {
    font-size: 22px;
  }

  .count-badge {
    background: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .active-filters {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .active-filter-label {
    font-size: 12px;
    color: var(--text-dim);
  }

  .clear-all-link {
    font-size: 12px;
    color: var(--accent-cyan);
    text-decoration: underline;
    margin-left: 6px;
  }

  .materials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 20px;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }

  .empty-icon {
    font-size: 40px;
    margin-bottom: 16px;
  }

  .empty-state h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }

  .empty-state p {
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto;
  }

  @media (max-width: 992px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .filters-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
    .filters-row {
      grid-template-columns: 1fr;
    }
    .materials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
