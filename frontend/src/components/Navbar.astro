---
const pathname = Astro.url.pathname;
---

<header class="navbar-wrapper">
  <div class="container navbar-inner">
    <a href="/" class="brand-logo" id="nav-brand-logo">
      <div class="brand-badge">FIUBA</div>
      <div class="brand-text">
        <span class="brand-title">Planificaciones & Bibliografía</span>
        <span class="brand-sub">Sistema de Consulta Académica</span>
      </div>
    </a>

    <nav class="nav-links">
      <a 
        href="/" 
        class={`nav-link ${pathname === '/' ? 'active' : ''}`}
        id="nav-link-inicio"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        Buscador de Bibliografía
      </a>

      <a 
        href="/materias" 
        class={`nav-link ${pathname.startsWith('/materias') ? 'active' : ''}`}
        id="nav-link-materias"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        Materias
      </a>

      <a 
        href="/planificaciones" 
        class={`nav-link ${pathname === '/planificaciones' ? 'active' : ''}`}
        id="nav-link-planificaciones"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Planificaciones Cuatrimestrales
      </a>
    </nav>

    <div class="nav-actions">
      <div class="db-pill">
        <span class="pulse-indicator"></span>
        <span class="mono">PostgreSQL</span>
      </div>
    </div>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(9, 13, 22, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-badge {
    background: linear-gradient(135deg, #6366f1 0%, #3b82f6 100%);
    color: white;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.08em;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .brand-sub {
    font-size: 11px;
    color: var(--text-dim);
    font-weight: 500;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.03);
    padding: 4px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-link.active {
    color: #ffffff;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.25) 0%, rgba(99, 102, 241, 0.1) 100%);
    border: 1px solid rgba(99, 102, 241, 0.4);
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.2);
  }

  .db-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 9999px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #34d399;
    font-size: 12px;
    font-weight: 600;
  }

  .pulse-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  @media (max-width: 850px) {
    .navbar-inner {
      flex-direction: column;
      height: auto;
      padding: 14px 20px;
      gap: 12px;
    }
    .nav-links {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }
    .db-pill {
      display: none;
    }
  }
</style>
